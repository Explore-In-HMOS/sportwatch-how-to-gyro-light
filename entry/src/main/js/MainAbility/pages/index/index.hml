<div class="container" style="background-color: {{bgColor}};">
    <text class="title">GyroLight</text>

    <text class="value">{{brightness}}</text>
    <text class="label">Brightness</text>

    <text class="value" style="margin-top: 30px;">{{angle}}°</text>
    <text class="label">Angle</text>

    <input type="button" class="btn" value="Reset" onclick="calibrate"></input>
</div>